        <string notr="true">/* 所有标签默认：白底黑字 */
QTabBar::tab {
    background-color: white;
    color: black;
    border: 1px solid #cccccc;
    padding: 6px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 3px;
}
/* 选中的标签（保持白底黑字，加深边框区分） */
QTabBar::tab:selected {
    background-color: white;
    color: black;
    border-bottom: none;
}
/* 鼠标悬浮标签 */
QTabBar::tab:hover:!selected {
    background-color: #f5f5f5;
    color: black;
}
/* 下方内容面板边框 */
QTabWidget::pane {
    border:1px solid #cccccc;
    border-top:0;
}
</string>
